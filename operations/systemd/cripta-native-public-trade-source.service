[Unit]
Description=Cripta independent credential-free native Bybit publicTrade capture
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=cripta
Group=cripta
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/srv/cripta/runtime/current/src:/srv/cripta/runtime/current
EnvironmentFile=/etc/cripta/release.env
Environment=CRIPTA_NATIVE_PUBLIC_TRADE_SYMBOLS=APTUSDT,ARBUSDT,DOTUSDT,INJUSDT,LTCUSDT
# R04: one native five-symbol source/writer handles original publicTrade,
# confirmed closed LINEAR candles plus optional SPOT/topics/REST.
# This CHANGES the producer ABI: release ONLY through the native source
# cutover rail, with old-session GAP, new PID/session and independent QC.
# R03 closed-only and R04 union are mutually exclusive.
# R05 publishes immutable committed PG references in the SAME native process.
# Producer code/unit changes require a controlled native GAP/cutover; no new
# source owner, consumer cutover, Strategy activation, Exchange or LIVE action.
Environment=CRIPTA_SOURCE_CLOSED_KLINES=0
Environment=CRIPTA_SOURCE_UNION_CAPTURE=1
Environment=CRIPTA_SOURCE_PUBLICATION=1
Environment=CRIPTA_SOURCE_KLINE_INTERVALS=1,5,15
Environment=CRIPTA_SOURCE_UNION_MANIFEST_FILE=/etc/cripta/market-source/required_public_feeds.json
WorkingDirectory=/srv/cripta/runtime/current
ExecStart=/srv/cripta/runtime/current/.venv/bin/python /srv/cripta/runtime/current/operations/monitoring/native_public_trade_source.py
Restart=on-failure
RestartSec=5
StateDirectory=cripta/native_public_trade_source
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027
ReadOnlyPaths=/srv/cripta/runtime/current
ReadWritePaths=/var/lib/cripta/native_public_trade_source

[Install]
WantedBy=multi-user.target
