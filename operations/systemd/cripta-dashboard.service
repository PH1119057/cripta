[Unit]
Description=Cripta research infrastructure dashboard
After=network-online.target data-cripta.mount
Wants=network-online.target

[Service]
Type=simple
User=cripta
Group=cripta
SupplementaryGroups=systemd-journal
WorkingDirectory=/srv/cripta/runtime/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/cripta/release.env
Environment=CRIPTA_DATA_ROOT=/data/cripta
Environment=CRIPTA_APP_ROOT=/srv/cripta
Environment=CRIPTA_UNIVERSAL_ENTRY_SOURCE=/srv/cripta/runtime/current/src
Environment=PYTHONPATH=/srv/cripta/runtime/current/src
ExecStart=/srv/cripta/runtime/current/.venv/bin/python /srv/cripta/runtime/current/operations/dashboard/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/data/cripta /srv/cripta
ReadWritePaths=/srv/cripta-share/reports /srv/cripta-share/.archive_jobs /var/lib/cripta/archive_jobs

[Install]
WantedBy=multi-user.target
