[Unit]
Description=Cripta Entry V1 shadow-only live scanner
After=network-online.target postgresql.service cripta-opportunity-tracker.service
Wants=network-online.target

[Service]
Type=simple
User=cripta
Group=cripta
WorkingDirectory=/data/cripta/research/worktrees/universal_entry_v1/source_stage
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/data/cripta/research/worktrees/universal_entry_v1/source_stage/src:/data/cripta/research/worktrees/minute_entry_book_v1/.venv/lib/python3.12/site-packages
ExecStart=/srv/cripta/runtime/current/.venv/bin/python /srv/cripta/runtime/current/operations/monitoring/entry_shadow_scanner.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/data/cripta/research/worktrees/universal_entry_v1/source_stage
ReadWritePaths=/var/lib/cripta/entry_shadow

[Install]
WantedBy=multi-user.target
