[Unit]
Description=Cripta Mayak V2 passive seven-day report
After=postgresql.service cripta-mayak-v2.service

[Service]
Type=oneshot
User=cripta
Group=cripta
SupplementaryGroups=cripta-share
ExecStartPre=/usr/local/sbin/cripta-permission-preflight --actor cripta --check create-child:/srv/cripta-share/reports
ExecStart=/usr/bin/python3 /srv/cripta/monitoring/mayak_v2_report.py 7
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/cripta-share/reports
