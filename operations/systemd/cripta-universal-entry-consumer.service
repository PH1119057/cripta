[Unit]
Description=Cripta dormant Universal Entry execution consumer
After=network-online.target postgresql.service cripta-private-runtime.service
Wants=network-online.target

[Service]
Type=simple
User=cripta
Group=cripta
WorkingDirectory=/srv/cripta/universal_entry_consumer/current
Environment=PYTHONUNBUFFERED=1
Environment=CRIPTA_ENTRY_COMMAND_SOURCE=LEGACY_V1
Environment=CRIPTA_UNIVERSAL_ENTRY_MAINNET_CONSUMER=DISABLED
EnvironmentFile=-/etc/cripta/universal_entry_consumer.env
Environment=PYTHONPATH=/srv/cripta/universal_entry_consumer/current/src:/srv/cripta/test_gate_venv/lib/python3.12/site-packages
ExecStart=/usr/bin/python3 /srv/cripta/universal_entry_consumer/current/operations/connectivity/universal_entry_consumer.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
