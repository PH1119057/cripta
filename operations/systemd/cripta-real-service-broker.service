[Unit]
Description=Cripta bounded REAL service-start broker
After=local-fs.target
ConditionPathExists=/usr/local/libexec/cripta-real-service-broker/real_service_broker.py
ConditionPathExists=/var/lib/cripta/release/INSTALLED_COMMIT

[Service]
Type=simple
User=root
Group=cripta
UMask=0007
Environment=PYTHONPATH=
Environment=PYTHONNOUSERSITE=1
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /usr/local/libexec/cripta-real-service-broker/real_service_broker.py
Restart=on-failure
RestartSec=2
TimeoutStartSec=20
TimeoutStopSec=10
RuntimeDirectory=cripta-real-readiness
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/usr/local/libexec/cripta-real-service-broker
ReadOnlyPaths=/srv/cripta/runtime/current
ReadOnlyPaths=/var/lib/cripta/release
ReadWritePaths=/run/cripta-real-readiness

[Install]
WantedBy=multi-user.target
