[Unit]
Description=Cripta Universal Exit decision-only shadow owner
After=postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=cripta
Group=cripta
WorkingDirectory=/srv/cripta/trade_lifecycle/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/cripta/release.env
Environment=PYTHONPATH=/srv/cripta/trade_lifecycle/current/src:/srv/cripta/test_gate_venv/lib/python3.12/site-packages
Environment=CRIPTA_UNIVERSAL_EXIT_SHADOW=ENABLED
Environment=CRIPTA_UNIVERSAL_EXIT_SHADOW_CONSUMER_ID=universal-exit-shadow-v1
Environment=CRIPTA_UNIVERSAL_EXIT_SHADOW_POLL_SECONDS=1
Environment=CRIPTA_UNIVERSAL_EXIT_SHADOW_STATUS_PATH=/var/lib/cripta/universal_exit_shadow/status.json
ExecStart=/usr/bin/python3 /srv/cripta/trade_lifecycle/current/operations/monitoring/universal_exit_shadow_runtime.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/srv/cripta/trade_lifecycle/current
ReadWritePaths=/var/lib/cripta/universal_exit_shadow

[Install]
WantedBy=multi-user.target
