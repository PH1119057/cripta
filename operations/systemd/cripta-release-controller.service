[Unit]
Description=Cripta permanent bounded Release Controller
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/srv/cripta/runtime/current/operations/infrastructure/cripta-release-controller
ConditionPathExists=/var/lib/cripta/release-controller

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/srv/cripta/runtime/current/.venv/bin/python /srv/cripta/runtime/current/operations/infrastructure/cripta-release-controller
TimeoutStartSec=1800
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/cripta/source_checkout
ReadWritePaths=/srv/cripta/runtime
ReadWritePaths=/srv/cripta/dashboard-ui
ReadWritePaths=/data/cripta/research/tooling
ReadWritePaths=/data/cripta/script_archive/release_backups
ReadWritePaths=/data/cripta/datasets/raw/bybit_public_trades_daily_v1
ReadWritePaths=/var/lib/cripta/release
ReadWritePaths=/var/lib/cripta/release-controller
ReadWritePaths=/etc/cripta
ReadWritePaths=/etc/systemd/system
ReadWritePaths=/usr/local/sbin
ReadWritePaths=/run/lock

[Install]
WantedBy=multi-user.target
