[Unit]
Description=Cripta Universal Entry U5 parity shadow
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=cripta
Group=cripta
WorkingDirectory=/srv/cripta/runtime/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/srv/cripta/runtime/current/src:/srv/cripta/runtime/current/.venv/lib/python3.12/site-packages
EnvironmentFile=/etc/cripta/universal_entry_shadow.env
ExecStart=/srv/cripta/runtime/current/.venv/bin/python /srv/cripta/runtime/current/operations/monitoring/universal_entry_shadow.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027
ReadOnlyPaths=/srv/cripta/runtime/current
ReadWritePaths=/var/lib/cripta/universal_entry_shadow

[Install]
WantedBy=multi-user.target
