[Unit]
Description=Cripta U5 public REST current OI30S source soak
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cripta
Group=cripta
WorkingDirectory=/srv/cripta/runtime/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/srv/cripta/runtime/current/src:/srv/cripta/runtime/current/.venv/lib/python3.12/site-packages
EnvironmentFile=/etc/cripta/u5_oi30s_source_soak.env
ExecStart=/srv/cripta/runtime/current/.venv/bin/python /srv/cripta/runtime/current/operations/monitoring/u5_oi30s_source_soak.py
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027
ReadOnlyPaths=/srv/cripta/runtime/current
ReadWritePaths=/var/lib/cripta/u5_oi30s_source_soak

[Install]
WantedBy=multi-user.target
