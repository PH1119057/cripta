class StagedReleaseError(RuntimeError):
    pass


def _run(args: list[str], *, check: bool = True, text: bool = True) -> subprocess.CompletedProcess:
    result = subprocess.run(args, check=False, capture_output=True, text=text)
    if check and result.returncode != 0:
        detail = result.stderr.strip() if text else "command failed"
        raise StagedReleaseError(f"COMMAND_FAILED:{Path(args[0]).name}:{result.returncode}:{detail[:300]}")
    return result


def _run_as_cripta(
    args: list[str], *, check: bool = True, text: bool = True,
) -> subprocess.CompletedProcess:
    """Run one bounded child as cripta through PID1, never setuid under NNP."""
    return _run([
        "/usr/bin/systemd-run",
        "--wait", "--pipe", "--collect", "--quiet",
        "--property=Type=oneshot",
        "--property=User=cripta",
        "--property=Group=cripta",
        "--property=NoNewPrivileges=yes",
        "--property=PrivateTmp=yes",
        "--property=ProtectHome=yes",
        "--property=ProtectSystem=strict",
        "--property=ReadOnlyPaths=/srv/cripta/source_checkout",
        "/usr/bin/env",
        "GIT_OPTIONAL_LOCKS=0",
        "GIT_TERMINAL_PROMPT=0",
        *args,
    ], check=check, text=text)


def _git_as_cripta(*args: str) -> str:
    result = _run_as_cripta([
        "/usr/bin/git", "-C", str(SOURCE), *args,
    ])
    return result.stdout.strip()


def _read_commit(path: Path) -> str:
    commit = (path / "INSTALLED_COMMIT").read_text(encoding="ascii").strip()
    if SHA.fullmatch(commit) is None:
        raise StagedReleaseError(f"INSTALLED_COMMIT_INVALID:{path}")
    return commit


def next_stage(installed: str) -> tuple[str, str, str]:
    for stage, baseline, target in STAGES:
        if installed == baseline:
            return stage, baseline, target
    if installed == STAGES[-1][2]:
        raise StagedReleaseError("ROADMAP470_R07_R13_ALREADY_INSTALLED")
    raise StagedReleaseError("ROADMAP470_INSTALLED_BASELINE_NOT_IN_FIXED_LADDER")


def _git_bytes(commit: str, relative: str) -> bytes:
    result = _run_as_cripta([
        "/usr/bin/git", "-C", str(SOURCE),
        "show", f"{commit}:{relative}",
    ], text=False)
    return result.stdout


def _verify_rail(remote: str) -> str:
    rail_commit = RAIL_MARKER.read_text(encoding="ascii").strip()
    if SHA.fullmatch(rail_commit) is None:
        raise StagedReleaseError("ROADMAP470_RAIL_COMMIT_INVALID")
    _git_as_cripta("cat-file", "-e", f"{rail_commit}^{{commit}}")
    if _run_as_cripta([
        "/usr/bin/git", "-C", str(SOURCE),
        "merge-base", "--is-ancestor", rail_commit, remote,
    ], check=False).returncode != 0:
        raise StagedReleaseError("ROADMAP470_RAIL_NOT_ANCESTOR_OF_MAIN")
    expected = _git_bytes(rail_commit, SELF_REL)
    actual = SELF_PATH.read_bytes()
    if actual != expected:
        raise StagedReleaseError("ROADMAP470_RAIL_BYTES_DRIFT")
    return rail_commit


def main() -> int:
    if len(sys.argv) != 1:
        raise StagedReleaseError("ROADMAP470_RAIL_TAKES_NO_ARGUMENTS")
    if os.geteuid() != 0:
        raise StagedReleaseError("ROADMAP470_RAIL_REQUIRES_ROOT")
    lock_fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise StagedReleaseError("ROADMAP470_RELEASE_LOCK_BUSY") from exc

        branch = _git_as_cripta("symbolic-ref", "--quiet", "--short", "HEAD")
        dirty = _git_as_cripta("status", "--porcelain=v1", "--untracked-files=all")
        head = _git_as_cripta("rev-parse", "HEAD")
        remote_line = _git_as_cripta("ls-remote", "origin", "refs/heads/main")
        remote = remote_line.split()[0] if remote_line else ""
        if branch != "main" or dirty:
            raise StagedReleaseError("ROADMAP470_SOURCE_NOT_CLEAN_MAIN")
        if SHA.fullmatch(remote) is None or head != remote:
            raise StagedReleaseError("ROADMAP470_SOURCE_NOT_CURRENT_REMOTE_MAIN")
        rail_commit = _verify_rail(remote)

        runtime = _read_commit(RUNTIME_CURRENT)
        tooling = _read_commit(TOOLING_CURRENT)
        if runtime != tooling:
            raise StagedReleaseError("ROADMAP470_RUNTIME_TOOLING_BASELINE_SPLIT")
        stage, baseline, target = next_stage(runtime)
        _git_as_cripta("cat-file", "-e", f"{target}^{{commit}}")
        ancestor = _run_as_cripta([
            "/usr/bin/git", "-C", str(SOURCE),
            "merge-base", "--is-ancestor", target, remote,
        ], check=False)
        if ancestor.returncode != 0:
            raise StagedReleaseError("ROADMAP470_TARGET_NOT_ANCESTOR_OF_MAIN")
        tree = _git_as_cripta("rev-parse", f"{target}^{{tree}}")

        installer = _git_bytes(rail_commit, INSTALLER_REL)
        if not installer.startswith(b"#!/usr/bin/env bash\n"):
            raise StagedReleaseError("ROADMAP470_INSTALLER_BYTES_INVALID")
        if os.environ.get("CRIPTA_ROADMAP470_PREFLIGHT_ONLY") == "1":
            print(
                f"ROADMAP470_PREFLIGHT_ONLY=PASS stage={stage} "
                f"baseline={baseline} target={target} rail={rail_commit}"
            )
            return 0
        digest = hashlib.sha256(
            f"{rail_commit}:{stage}:{baseline}:{target}".encode("ascii")
        ).hexdigest()[:12]
        with tempfile.NamedTemporaryFile(
            prefix="cripta-roadmap470-installer.", dir="/run/lock", delete=False
        ) as staged:
            staged.write(installer)
            staged.flush()
            os.fsync(staged.fileno())
            staged_path = Path(staged.name)
        os.chmod(staged_path, 0o700)
        try:
            print(
                f"ROADMAP470_STAGE_PREPARED={stage} BASELINE={baseline} "
                f"TARGET={target} RAIL={rail_commit}"
            )
            result = subprocess.run([
                "/usr/bin/systemd-run",
                "--wait", "--pipe", "--collect",
                f"--unit=cripta-roadmap470-{stage.lower()}-{digest}",
                "--property=Type=oneshot",
                "--property=TimeoutStartSec=1800",
                "/usr/bin/env",
                f"CRIPTA_RELEASE_COMMIT={target}",
                f"CRIPTA_EXPECTED_BASELINE_COMMIT={baseline}",
                f"CRIPTA_RELEASE_TREE_SHA={tree}",
                "CRIPTA_RELEASE_CONTROL_CHECKPOINT=1",
                f"CRIPTA_RELEASE_CONTROL_REASON=ROADMAP470_{stage}_STAGED_ACCEPTANCE",
                "CRIPTA_STAGED_OFFLINE_CUTOVER=1",
                "CRIPTA_NATIVE_SOURCE_CUTOVER=0",
                f"CRIPTA_ROADMAP470_STAGE={stage}",
                "/usr/bin/bash", str(staged_path),
            ], check=False, capture_output=True, text=True)
            if result.returncode != 0:
                combined = "\n".join(
                    part for part in (result.stdout, result.stderr) if part
                )
                safe_lines = [
                    line[:600]
                    for line in combined.splitlines()[-60:]
                    if not SENSITIVE_DIAGNOSTIC.search(line)
                ]
                if safe_lines:
                    print(
                        "ROADMAP470_INSTALLER_DIAGNOSTIC_BEGIN",
                        file=sys.stderr,
                    )
                    print("\n".join(safe_lines), file=sys.stderr)
                    print(
                        "ROADMAP470_INSTALLER_DIAGNOSTIC_END",
                        file=sys.stderr,
                    )
                raise StagedReleaseError(
                    f"ROADMAP470_STAGE_INSTALL_FAILED:{stage}:{result.returncode}"
                )
        finally:
            staged_path.unlink(missing_ok=True)
        print(f"ROADMAP470_STAGE_INSTALL_COMPLETED={stage} TARGET={target}")
        return 0
    finally:
        os.close(lock_fd)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except StagedReleaseError as exc:
        print(f"ROADMAP470_STAGED_RELEASE=BLOCKED reason={exc}", file=sys.stderr)
        raise SystemExit(42)
