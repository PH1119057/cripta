[Unit]
Description=Cripta read-only Bybit low-latency telemetry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cripta
Group=cripta
Environment=CRIPTA_SYMBOLS=AAVEUSDT,ADAUSDT,APTUSDT,ARBUSDT,AVAXUSDT,BCHUSDT,BNBUSDT,DOTUSDT,HBARUSDT,INJUSDT,LINKUSDT,LTCUSDT,NEARUSDT,OPUSDT,SOLUSDT,SUIUSDT,TRXUSDT,UNIUSDT,XLMUSDT,XRPUSDT,BTCUSDT,ETHUSDT
ExecStart=/usr/bin/python3 /srv/cripta/connectivity/latency_probe.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cripta/connectivity

[Install]
WantedBy=multi-user.target
