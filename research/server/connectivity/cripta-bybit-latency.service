[Unit]
Description=Cripta read-only Bybit low-latency telemetry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cripta
Group=cripta
Environment=CRIPTA_SYMBOLS=AAVEUSDT,ADAUSDT,APTUSDT,ARBUSDT,AVAXUSDT,BCHUSDT,BNBUSDT,DOTUSDT,HBARUSDT,INJUSDT,LINKUSDT,LTCUSDT,OPUSDT,SOLUSDT,SUIUSDT,TRXUSDT,UNIUSDT,XRPUSDT,BTCUSDT,ETHUSDT
ExecStart=/srv/cripta/runtime/current/.venv/bin/python /srv/cripta/runtime/current/research/server/connectivity/latency_probe.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cripta/connectivity

[Install]
WantedBy=multi-user.target