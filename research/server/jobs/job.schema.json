{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cripta 2 research job",
  "type": "object",
  "required": ["job_id", "title", "line", "entrypoint", "dataset", "parameters", "dependencies"],
  "properties": {
    "job_id": {"type": "string", "pattern": "^C2-R[0-9]{3,6}-[A-Z0-9][A-Z0-9_-]{1,40}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 160},
    "line": {"enum": ["current", "legacy-recheck"]},
    "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.py$"},
    "dataset": {
      "type": "object",
      "required": ["period", "symbols"],
      "properties": {
        "period": {"type": "string", "pattern": "^[0-9]{8}_[0-9]{8}$"},
        "symbols": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z0-9]+USDT$"}}
      }
    },
    "parameters": {"type": "object"},
    "dependencies": {"type": "array", "items": {"type": "string", "maxLength": 100}},
    "timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 604800},
    "notes": {"type": "string", "maxLength": 4000}
  },
  "additionalProperties": false
}
